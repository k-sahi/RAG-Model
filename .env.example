# Generation. Set one key; with neither set, answers are extractive (no LLM).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# HELIX_LLM_PROVIDER=auto          # auto | anthropic | openai | extractive
# ANTHROPIC_MODEL=claude-sonnet-4-5
# OPENAI_MODEL=gpt-4o-mini

# Embeddings: local (TF-IDF + SVD, offline) or openai (text-embedding-3-small)
# HELIX_EMBEDDER=local

# Retrieval
# HELIX_RERANKER=local             # local | llm | none
# HELIX_QUERY_REWRITE=0            # 1 = LLM rewrites the query before search
# HELIX_TOP_K=8
# HELIX_MAX_DOCS=3
# HELIX_PER_DOC=3
# HELIX_RELATIVE_CUTOFF=0.75
# HELIX_CHUNK_CUTOFF=0.7
# HELIX_ABSTAIN_THRESHOLD=0.36

# Optional Pinecone index (cosine metric, dimension must match the embedder)
# PINECONE_API_KEY=
# PINECONE_INDEX_HOST=
